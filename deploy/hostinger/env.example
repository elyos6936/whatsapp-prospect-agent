# Klanvio API — production Hostinger
PORT=3001
NODE_ENV=production

# Supabase Postgres (Settings → Database → Connection string, mode Transaction pooler)
DATABASE_URL=postgresql://postgres.fveofdyyqbirfzhdvdvw:[MOT_DE_PASSE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://fveofdyyqbirfzhdvdvw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# IA — Mistral Medium 3.5
LLM_PROVIDER=mistral
LLM_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=
LLM_MODEL=mistral-medium-3-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Auth JWT
JWT_SECRET=

# Panneau ops Hostinger — https://api.klanvio.com/ops (PAS sur www.klanvio.com)
# Compte séparé des utilisateurs produit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optionnel : hash bcrypt à la place de ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# Evolution API (plateforme — une instance par utilisateur klanvio_<id>)
EVOLUTION_API_BASE_URL=https://evolution-api-kxse.srv1820011.hstgr.cloud
EVOLUTION_API_KEY=

# Origines autorisées (frontend Vercel — *.vercel.app accepté aussi par le serveur)
CORS_ORIGINS=https://www.klanvio.com,https://klanvio.com,https://klanvio.vercel.app

# URL publique de cette API (webhooks Evolution + Money Fusion + OAuth)
PUBLIC_URL=https://api.klanvio.com

# Front(s) redirects OAuth / retour paiement — liste CSV ; www.klanvio.com est toujours préféré.
# Ne pas mettre PUBLIC_URL / l’URL API Hostinger ici (sinon redirect OAuth cassé).
APP_URL=https://www.klanvio.com,https://klanvio.vercel.app

# Money Fusion (FusionPay) — lien « API de paiement » généré dans la console Money Fusion
# Checkout one-click : carte + Mobile Money sur la page hébergée FusionPay
MONEYFUSION_API_URL=
# Optionnel (défaut : https://www.pay.moneyfusion.net/paiementNotif)
# MONEYFUSION_VERIFY_BASE_URL=https://www.pay.moneyfusion.net/paiementNotif

# Typeform OAuth — Redirect URI exacte à coller dans l'app Typeform :
# https://api.klanvio.com/api/integrations/typeform/callback
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=

# Google Intégrations (OAuth client séparé du login GOOGLE_CLIENT_ID)
# Redirect URI :
# https://klanvio-api.srv1820011.hstgr.cloud/api/integrations/google/callback
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=

# Chiffrement tokens intégrations (64 hex). Ne JAMAIS changer en prod.
# openssl rand -hex 32
TOKENS_ENCRYPTION_KEY=

# Resend — rapports hebdomadaires vendredi 20h (domaine klanvio.com vérifié côté Resend)
# Obligatoire aussi dans docker-compose.yml → environment: (sinon le conteneur ignore ces lignes).
RESEND_API_KEY=
RESEND_FROM=rapports@klanvio.com
