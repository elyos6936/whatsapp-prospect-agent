# PostgreSQL (Supabase) — obligatoire
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth JWT (générer une chaîne aléatoire longue)
JWT_SECRET=

# Connexion Google (OAuth) — ID client obtenu sur console.cloud.google.com
# (API & Services → Identifiants → ID client OAuth 2.0, type « Application Web »).
# Le même ID doit être exposé au frontend via VITE_GOOGLE_CLIENT_ID (build Netlify).
# ⚠️ Client LOGIN uniquement (GIS / ID token) — distinct du client Intégrations ci-dessous.
GOOGLE_CLIENT_ID=

# Google Intégrations (Sheets / futur Forms, Calendar) — 2ᵉ OAuth Client Web, séparé du login.
# Redirect URI exacte :
#   {PUBLIC_URL}/api/integrations/google/callback
# ex. https://klanvio-api.srv1937804.hstgr.cloud/api/integrations/google/callback
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
# Optionnel si différent du défaut ci-dessus :
# GOOGLE_INTEGRATIONS_REDIRECT_URI=

# Front(s) pour redirects OAuth — liste CSV OK (comme CORS_ORIGINS).
# La redirect utilise www.klanvio.com si présent, sinon la 1ʳᵉ URL https.
APP_URL=https://www.klanvio.com,https://klanvio.vercel.app,https://klanvio.com,https://klanvio.netlify.app

# Typeform OAuth (Applications → Create application sur admin.typeform.com)
# Redirect URI à enregistrer chez Typeform (exact) :
#   {PUBLIC_URL}/api/integrations/typeform/callback
# ex. https://klanvio-api.srv1937804.hstgr.cloud/api/integrations/typeform/callback
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
# Optionnel si différent du défaut ci-dessus :
# TYPEFORM_REDIRECT_URI=

# Calendly OAuth (https://developer.calendly.com/ → My Apps → Create new app)
# Redirect URI à enregistrer chez Calendly (exact, HTTPS en Production) :
#   {PUBLIC_URL}/api/integrations/calendly/callback
# ex. https://klanvio-api.srv1937804.hstgr.cloud/api/integrations/calendly/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Optionnel si différent du défaut ci-dessus :
# CALENDLY_REDIRECT_URI=

# Tally : pas de credentials serveur — chaque user colle sa clé API
# (https://tally.so/settings/api-keys) dans Réglages → Intégrations.

# Chiffrement au repos des tokens d'intégrations (AES-256-GCM).
# Générer UNE FOIS : openssl rand -hex 32  (ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ⚠️ Ne JAMAIS changer cette clé en production : tous les tokens stockés deviennent illisibles.
TOKENS_ENCRYPTION_KEY=

# Plateforme gérée — IA
# Chat = MiniMax partout (dialogue + boucle agent + outils).
# Claude = filet UNIQUEMENT pour générer la simulation téléphone (comme DeepSeek avant).
# Activation campagne = déterministe (sans LLM). DeepSeek désactivé.
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
TOOL_LLM_PROVIDER=claude
TOOL_LLM_BASE_URL=https://api.anthropic.com/v1
TOOL_LLM_MODEL=claude-sonnet-4-5
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

EVOLUTION_API_BASE_URL=https://votre-serveur-evolution.com
EVOLUTION_API_KEY=

PORT=3000

# URL publique du backend (webhooks Evolution + Money Fusion)
PUBLIC_URL=https://votre-api.example.com

# Money Fusion — lien API généré dans la console (carte + Mobile Money)
MONEYFUSION_API_URL=
# MONEYFUSION_VERIFY_BASE_URL=https://pay.moneyfusion.net/paiementNotif

# CORS (frontend Netlify)
CORS_ORIGINS=https://www.klanvio.com,https://klanvio.com,http://localhost:3000,http://localhost:5174

# Resend — rapports hebdomadaires par e-mail (from: rapports@klanvio.com)
# Domaine klanvio.com doit être vérifié dans le dashboard Resend (DNS Hostinger).
# Envoi : vendredi ≥ 20h (APP_TIMEZONE), campagnes actives uniquement.
RESEND_API_KEY=
RESEND_FROM=rapports@klanvio.com

# Support client (chat Grace + inbox /support) — optionnel, surchargeables
# Sans ces variables : userId WhatsApp = 1, notif handoff = +22969360940
# SUPPORT_WHATSAPP_USER_ID=1
# SUPPORT_HANDOFF_PHONE=+22969360940
